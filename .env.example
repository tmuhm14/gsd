# Neon connection string (use the pooled URL for serverless)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# 32+ chars. Generate: openssl rand -base64 32
SESSION_SECRET=""

# Generate both with: pnpm tsx scripts/hash-password.ts "your-password"
APP_PASSWORD_SALT=""
APP_PASSWORD_HASH=""

# Optional — enables the AI actions. Without it the app runs, but AI is disabled.
ANTHROPIC_API_KEY=""

# Optional — enables the Jira lookup tool in AI actions.
# Token: id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL="https://your-org.atlassian.net"
JIRA_EMAIL=""
JIRA_API_TOKEN=""
